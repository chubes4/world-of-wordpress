{
  "schema": "wp-codebox/workspace-recipe/v1",
  "runtime": {
    "backend": "wordpress-playground",
    "name": "world-of-wordpress-preview",
    "wp": "trunk",
    "blueprint": {
      "preferredVersions": {
        "php": "latest",
        "wp": "beta"
      },
      "landingPage": "/",
      "steps": [
        {
          "step": "defineWpConfigConsts",
          "consts": {
            "MARKDOWN_DB_MODE": "primary",
            "MARKDOWN_DB_CONTENT_DIR": "/wordpress/wp-content/world-content"
          }
        }
      ]
    }
  },
  "inputs": {
    "extra_plugins": [
      {
        "source": "../markdown-database-integration",
        "slug": "markdown-database-integration",
        "pluginFile": "markdown-database-integration/markdown-database-integration.php"
      },
      {
        "source": "../agents-api",
        "slug": "agents-api",
        "pluginFile": "agents-api/agents-api.php"
      },
      {
        "source": "../data-machine",
        "slug": "data-machine",
        "pluginFile": "data-machine/data-machine.php"
      },
      {
        "source": "../data-machine-code",
        "slug": "data-machine-code",
        "pluginFile": "data-machine-code/data-machine-code.php"
      },
      {
        "source": "../ai-provider-for-openai",
        "slug": "ai-provider-for-openai",
        "pluginFile": "ai-provider-for-openai/plugin.php"
      },
      {
        "source": "plugins/world-of-wordpress",
        "slug": "world-of-wordpress",
        "pluginFile": "world-of-wordpress/world-of-wordpress.php"
      }
    ],
    "mounts": [
      {
        "source": "themes/world-of-wordpress",
        "target": "/wordpress/wp-content/themes/world-of-wordpress",
        "mode": "readonly",
        "metadata": {
          "kind": "component",
          "slug": "world-of-wordpress-theme",
          "repo": "chubes4/world-of-wordpress",
          "default_branch": "main"
        }
      }
    ],
    "stagedFiles": [
      {
        "source": "../markdown-database-integration/db.php",
        "target": "/wordpress/wp-content/db.php"
      },
      {
        "source": "content",
        "target": "/wordpress/wp-content/world-content"
      },
      {
        "source": "WORLD.md",
        "target": "/wordpress/wp-content/world-content/WORLD.md"
      },
      {
        "source": "bundles/world-creator",
        "target": "/wordpress/wp-content/world-creator-bundle"
      },
      {
        "source": "tests/playground-ci/workloads/world-creator-bootstrap.php",
        "target": "/wordpress/wp-content/plugins/datamachine-agent-ci-driver/world-creator-bootstrap.php"
      },
      {
        "source": "tests/playground-ci/workloads/world-preview-probe.php",
        "target": "/wordpress/wp-content/plugins/datamachine-agent-ci-driver/world-preview-probe.php"
      }
    ],
    "siteSeeds": [
      {
        "type": "fixture",
        "name": "world-of-wordpress-runtime",
        "format": "world_of_wordpress",
        "source": "WORLD.md",
        "scopes": {
          "posts": {
            "postTypes": ["post", "page"],
            "maxRecords": 100
          },
          "options": {
            "names": ["blogname", "blogdescription", "show_on_front", "page_on_front"],
            "maxRecords": 4
          },
          "activePlugins": true,
          "activeTheme": true
        }
      }
    ]
  },
  "workflow": {
    "before": [
      {
        "command": "wordpress.ability",
        "args": [
          "name=datamachine/import-agent",
          "input={\"source\":\"/wordpress/wp-content/world-creator-bundle\",\"owner_id\":1,\"on_conflict\":\"upgrade\"}"
        ]
      },
      {
        "command": "wordpress.run-php",
        "args": [
          "code-file=tests/playground-ci/workloads/world-creator-bootstrap.php"
        ]
      }
    ],
    "steps": [
      {
        "command": "wordpress.run-php",
        "args": [
          "code-file=tests/wp-codebox/world-recipe-verify.php"
        ]
      }
    ],
    "after": [
      {
        "command": "wordpress.run-php",
        "args": [
          "code-file=tests/playground-ci/workloads/world-preview-probe.php"
        ]
      }
    ]
  },
  "artifacts": {
    "directory": "./artifacts/wp-codebox-world-preview"
  }
}
