{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "MARKDOWN_DB_MODE": "primary",
        "MARKDOWN_DB_CONTENT_DIR": "/wordpress/wp-content/plugins/world-of-wordpress/content/markdown"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/db.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/chubes4/world-of-wordpress/main/db.php"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/Automattic/markdown-database-integration",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "markdown-database-integration"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/chubes4/world-of-wordpress",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "world-of-wordpress"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php if ( function_exists( 'markdown_database_integration_import_seed_posts_after_install' ) ) { markdown_database_integration_import_seed_posts_after_install(); } $page = get_page_by_path( 'home' ); if ( $page ) { update_option( 'show_on_front', 'page' ); update_option( 'page_on_front', (int) $page->ID ); }"
    }
  ]
}
