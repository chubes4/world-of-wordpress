{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "latest",
    "wp": "beta"
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "MARKDOWN_DB_MODE": "primary",
        "MARKDOWN_DB_CONTENT_DIR": "/wordpress/wp-content/world-content"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/db.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/Automattic/markdown-database-integration/main/db.php"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/Automattic/markdown-database-integration",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "markdown-database-integration"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/Automattic/agents-api",
        "ref": "main",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "agents-api"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/Extra-Chill/data-machine/releases/latest/download/data-machine.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "data-machine"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://github.com/Extra-Chill/data-machine-code/releases/latest/download/data-machine-code.zip"
      },
      "options": {
        "activate": true,
        "targetFolderName": "data-machine-code"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/WordPress/ai-provider-for-openai",
        "ref": "trunk",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "ai-provider-for-openai"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/chubes4/world-of-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "plugins/world-of-wordpress"
      },
      "options": {
        "activate": true,
        "targetFolderName": "world-of-wordpress"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "git:directory",
        "url": "https://github.com/chubes4/world-of-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "themes/world-of-wordpress"
      },
      "options": {
        "activate": true,
        "targetFolderName": "world-of-wordpress"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/world-content"
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/world-content",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/chubes4/world-of-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "content"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/world-content/WORLD.md",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/chubes4/world-of-wordpress/main/WORLD.md"
      }
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/world-creator-bundle",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/chubes4/world-of-wordpress",
        "ref": "main",
        "refType": "branch",
        "path": "bundles/world-creator"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $world = WP_PLUGIN_DIR . '/world-of-wordpress/world-of-wordpress.php'; if ( ! function_exists( 'world_of_wordpress_seed_world' ) && file_exists( $world ) ) { require_once $world; } if ( function_exists( 'world_of_wordpress_seed_world' ) ) { world_of_wordpress_seed_world(); }"
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; if ( ! function_exists( 'wp_get_ability' ) ) { return; } $ability = wp_get_ability( 'datamachine/import-agent' ); if ( ! $ability ) { return; } $result = $ability->execute( array( 'source' => '/wordpress/wp-content/world-creator-bundle', 'owner_id' => 1, 'on_conflict' => 'upgrade' ) ); error_log( 'world-creator bundle install: ' . wp_json_encode( $result ) );"
    }
  ]
}
