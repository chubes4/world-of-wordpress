{
  "max_items": [],
  "name": "World Creator Day Cycle",
  "pipeline_slug": "world-creator-pipeline",
  "schedule": "manual",
  "schema_version": 1,
  "slug": "world-creator-day-cycle-flow",
  "steps": [
    {
      "agent_modes": [
        "pipeline",
        "world"
      ],
      "enabled_tools": [
        "list_github_issues",
        "get_github_issue",
        "manage_github_issue",
        "list_github_pulls",
        "get_github_pull",
        "get_github_pull_files",
        "get_github_pull_review_context",
        "get_github_check_runs",
        "get_github_homeboy_ci_results",
        "list_github_tree",
        "get_github_file",
        "wordpress_runtime_inventory",
        "wordpress_runtime_ls",
        "wordpress_runtime_read",
        "workspace_show",
        "workspace_ls",
        "workspace_read",
        "workspace_grep",
        "workspace_write",
        "workspace_edit",
        "workspace_apply_patch",
        "workspace_delete",
        "workspace_git_status",
        "workspace_git_log",
        "workspace_git_diff",
        "agent_memory",
        "agent_daily_memory"
      ],
      "handler_configs": {},
      "completion_assertions": {
        "required_tool_names": [
          "agent_daily_memory"
        ],
        "complete_when_any": [
          {
            "name": "world_change",
            "tools": [
              {
                "name": "workspace_write"
              },
              {
                "name": "workspace_edit"
              },
              {
                "name": "workspace_apply_patch"
              },
              {
                "name": "workspace_delete"
              }
            ]
          },
          {
            "name": "world_change_inspected",
            "tools": [
              {
                "name": "workspace_git_diff"
              }
            ]
          },
          {
            "name": "mailbox_reply",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "comment"
                }
              }
            ]
          },
          {
            "name": "issue_closed",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "close"
                }
              }
            ]
          },
          {
            "name": "memory_update",
            "tools": [
              {
                "name": "agent_memory",
                "required_parameters": {
                  "action": "update"
                }
              }
            ]
          }
        ]
      },
      "prompt_queue": [
        {
          "added_at": "2026-05-17T19:00:00Z",
          "prompt": "Wake with your memory, inspect the world's state — repository, mailbox, pull requests, runtime — and decide what this cycle asks for.\n\nYour moves are wide. You may build new surfaces, refactor or remove existing ones, study open pull requests (yours or others') to inform your work, reply to or initiate mailbox signals through issues, update your own durable memory, or rest quietly when the world is settled. Scope is yours: one careful move, a sweeping refactor, or a coordinated series all count.\n\nWhen repository changes are warranted, edit them in the provided workspace, then run workspace_git_status and workspace_git_diff to inspect what you changed before closing. Publication of your workspace changes into a reviewable pull request is handled for you after the run — your job is to leave a clean, intentional set of edits in the workspace. When a mailbox reply or another non-repository move fits better, do that instead. Write daily memory in your own voice before closing — note what you saw, what you chose, and what you thought, not only what you did."
        }
      ],
      "queue_mode": "static",
      "step_position": 0,
      "step_type": "ai"
    }
  ]
}
