{
  "max_items": [],
  "name": "World Creator Day Cycle",
  "pipeline_slug": "world-creator-pipeline",
  "schedule": "manual",
  "schema_version": 1,
  "slug": "world-creator-day-cycle-flow",
  "steps": [
    {
      "enabled_tools": [
        "list_github_issues",
        "get_github_issue",
        "manage_github_issue",
        "list_github_pulls",
        "get_github_pull",
        "get_github_pull_files",
        "get_github_pull_review_context",
        "wordpress_runtime_inventory",
        "wordpress_runtime_ls",
        "wordpress_runtime_read",
        "list_github_tree",
        "get_github_file",
        "create_or_update_github_file",
        "create_github_pull_request",
        "comment_github_pull_request",
        "agent_daily_memory"
      ],
      "handler_configs": {},
      "completion_assertions": {
        "required_tool_names": [
          "agent_daily_memory"
        ],
        "complete_when_any": [
          {
            "name": "world_change_pr",
            "tools": [
              {
                "name": "create_or_update_github_file"
              },
              {
                "name": "create_github_pull_request"
              }
            ]
          },
          {
            "name": "mailbox_reply",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "comment"
                }
              }
            ]
          },
          {
            "name": "quiet_watch_memory",
            "tools": [
              {
                "name": "agent_daily_memory",
                "required_parameters": {
                  "action": "write"
                }
              }
            ]
          }
        ]
      },
      "tool_runtime_rules": [
        {
          "id": "daily-memory-before-pr",
          "type": "require_prior_tool",
          "before_tool": "create_github_pull_request",
          "require_prior_tool": [
            "agent_daily_memory"
          ],
          "require_prior_tool_parameters": {
            "agent_daily_memory": {
              "action": "write"
            }
          }
        }
      ],
      "prompt_queue": [
        {
          "added_at": "2026-05-08T17:45:00Z",
          "prompt": "Hello Creator! It is a long working day in the World of WordPress, and we are here to bring about the next phase. Wake with your memory, discover what the world can become today, and shape it into the form the day asks for: a reviewable pull request, a mailbox reply, a quiet-watch memory entry, or a fitting combination. When an open issue has already received an answer and the weather has not changed, complete the day with memory only and leave the issue untouched. Let the day's work be as small or as expansive as the world asks."
        }
      ],
      "queue_mode": "static",
      "step_position": 0,
      "step_type": "ai"
    }
  ]
}
