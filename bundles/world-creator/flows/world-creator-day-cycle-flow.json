{
  "max_items": [],
  "name": "World Creator Day Cycle",
  "pipeline_slug": "world-creator-pipeline",
  "schedule": "manual",
  "schema_version": 1,
  "slug": "world-creator-day-cycle-flow",
  "steps": [
    {
      "agent_mode": "world",
      "enabled_tools": [
        "list_github_issues",
        "get_github_issue",
        "manage_github_issue",
        "list_github_pulls",
        "get_github_pull",
        "get_github_pull_files",
        "get_github_pull_review_context",
        "wordpress_runtime_inventory",
        "wordpress_runtime_ls",
        "wordpress_runtime_read",
        "workspace_show",
        "workspace_ls",
        "workspace_read",
        "workspace_grep",
        "workspace_write",
        "workspace_edit",
        "workspace_apply_patch",
        "workspace_delete",
        "workspace_git_status",
        "workspace_git_log",
        "workspace_git_diff",
        "workspace_git_add",
        "workspace_git_commit",
        "workspace_git_push",
        "list_github_tree",
        "get_github_file",
        "create_github_pull_request",
        "comment_github_pull_request",
        "agent_daily_memory"
      ],
      "handler_configs": {},
      "completion_assertions": {
        "required_tool_names": [
          "agent_daily_memory"
        ],
        "complete_when_any": [
          {
            "name": "world_change_pr",
            "tools": [
              {
                "name": "workspace_git_commit"
              },
              {
                "name": "workspace_git_push"
              },
              {
                "name": "create_github_pull_request"
              }
            ]
          },
          {
            "name": "mailbox_reply",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "comment"
                }
              }
            ]
          }
        ]
      },
      "tool_runtime_rules": [
        {
          "id": "daily-memory-before-pr",
          "type": "require_prior_tool",
          "before_tool": "create_github_pull_request",
          "require_prior_tool": [
            "agent_daily_memory"
          ],
          "require_prior_tool_parameters": {
            "agent_daily_memory": {
              "action": "write"
            }
          }
        }
      ],
      "prompt_queue": [
        {
          "added_at": "2026-05-08T17:45:00Z",
          "prompt": "Wake with your memory, inspect the repository, issues, pull requests, and runtime, then decide what to do. If repository changes are warranted, use the provided workspace and open a pull request. If a mailbox reply is warranted, reply. Write daily memory before completion."
        }
      ],
      "queue_mode": "static",
      "step_position": 0,
      "step_type": "ai"
    }
  ]
}
