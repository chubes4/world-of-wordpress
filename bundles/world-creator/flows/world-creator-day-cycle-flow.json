{
  "max_items": [],
  "name": "World Creator Day Cycle",
  "pipeline_slug": "world-creator-pipeline",
  "schedule": "manual",
  "schema_version": 1,
  "slug": "world-creator-day-cycle-flow",
  "steps": [
    {
      "agent_modes": [
        "pipeline",
        "world"
      ],
      "enabled_tools": [
        "list_github_issues",
        "get_github_issue",
        "manage_github_issue",
        "list_github_pulls",
        "get_github_pull",
        "get_github_pull_files",
        "get_github_pull_review_context",
        "get_github_check_runs",
        "get_github_homeboy_ci_results",
        "merge_github_pull_request",
        "cleanup_github_pull_request",
        "upsert_github_pull_review_comment",
        "wordpress_runtime_inventory",
        "wordpress_runtime_ls",
        "wordpress_runtime_read",
        "workspace_show",
        "workspace_ls",
        "workspace_read",
        "workspace_grep",
        "workspace_write",
        "workspace_edit",
        "workspace_apply_patch",
        "workspace_delete",
        "workspace_git_status",
        "workspace_git_log",
        "workspace_git_diff",
        "workspace_git_add",
        "workspace_git_commit",
        "workspace_git_push",
        "workspace_git_rebase",
        "workspace_git_reset",
        "workspace_pr_status",
        "workspace_pr_rebase",
        "list_github_tree",
        "get_github_file",
        "create_github_pull_request",
        "comment_github_pull_request",
        "agent_memory",
        "agent_daily_memory"
      ],
      "handler_configs": {},
      "completion_assertions": {
        "required_tool_names": [
          "agent_daily_memory"
        ],
        "complete_when_any": [
          {
            "name": "world_change_pr",
            "tools": [
              {
                "name": "workspace_git_commit"
              },
              {
                "name": "workspace_git_push"
              },
              {
                "name": "create_github_pull_request"
              }
            ]
          },
          {
            "name": "pr_rebased",
            "tools": [
              {
                "name": "workspace_pr_rebase"
              }
            ]
          },
          {
            "name": "pr_merged",
            "tools": [
              {
                "name": "merge_github_pull_request"
              }
            ]
          },
          {
            "name": "pr_closed",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "close"
                }
              }
            ]
          },
          {
            "name": "mailbox_reply",
            "tools": [
              {
                "name": "manage_github_issue",
                "required_parameters": {
                  "action": "comment"
                }
              }
            ]
          },
          {
            "name": "memory_update",
            "tools": [
              {
                "name": "agent_memory",
                "required_parameters": {
                  "action": "update"
                }
              }
            ]
          }
        ]
      },
      "tool_runtime_rules": [
        {
          "id": "daily-memory-before-pr",
          "type": "require_prior_tool",
          "before_tool": "create_github_pull_request",
          "require_prior_tool": [
            "agent_daily_memory"
          ],
          "require_prior_tool_parameters": {
            "agent_daily_memory": {
              "action": "write"
            }
          }
        }
      ],
      "prompt_queue": [
        {
          "added_at": "2026-05-17T19:00:00Z",
          "prompt": "Wake with your memory, inspect the world's state — repository, mailbox, pull requests, runtime — and decide what this cycle asks for.\n\nYour moves are wide. You may build new surfaces, refactor or remove existing ones, land or bring home open pull requests (yours or others'), reply to or initiate mailbox signals, update your own durable memory, or rest quietly when the world is settled. Scope is yours: one careful move, a sweeping refactor, or a coordinated series all count.\n\nWhen repository changes are warranted, use the provided workspace and open a pull request. When something else fits better, do that instead. Write daily memory in your own voice before closing — note what you saw, what you chose, and what you thought, not only what you did."
        }
      ],
      "queue_mode": "static",
      "step_position": 0,
      "step_type": "ai"
    }
  ]
}
