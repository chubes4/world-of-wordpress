{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1120px"
    },
    "color": {
      "palette": [
        {
          "color": "#111827",
          "name": "Ink",
          "slug": "ink"
        },
        {
          "color": "#f8fafc",
          "name": "Paper",
          "slug": "paper"
        },
        {
          "color": "#3858e9",
          "name": "WordPress Blue",
          "slug": "wordpress-blue"
        },
        {
          "color": "#dbe4ff",
          "name": "Mist",
          "slug": "mist"
        }
      ],
      "gradients": [
        {
          "gradient": "linear-gradient(135deg, #eef4ff 0%, #f8fafc 42%, #dbe4ff 100%)",
          "name": "Dawn Glow",
          "slug": "dawn-glow"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "Georgia, 'Times New Roman', serif",
          "name": "Serif",
          "slug": "serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#f8fafc",
      "text": "#111827"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#3858e9"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "bottom": "0",
        "left": "1.5rem",
        "right": "1.5rem",
        "top": "0"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "18px",
      "lineHeight": "1.6"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ]
}
